{
    "alwaysThinkingEnabled": true,
    "attribution": {
        "commit": "",
        "pr": "",
        "sessionUrl": false
    },
    "enabledPlugins": {
        "agent-toolkit@mmalyska-claude-plugins": true,
        "android@mmalyska-claude-plugins": true,
        "backend@mmalyska-claude-plugins": true,
        "claude-md-management@claude-plugins-official": true,
        "code-simplifier@claude-plugins-official": true,
        "context7@claude-plugins-official": true,
        "devcontainer@mmalyska-claude-plugins": true,
        "development-lifecycle@mmalyska-claude-plugins": true,
        "devops@mmalyska-claude-plugins": true,
        "dotnet@mmalyska-claude-plugins": true,
        "frontend@mmalyska-claude-plugins": true,
        "git-workflows@mmalyska-claude-plugins": true,
        "personal-essentials@mmalyska-claude-plugins": true,
        "renovate@mmalyska-claude-plugins": true,
        "security@mmalyska-claude-plugins": true,
        "superpowers@claude-plugins-official": true
    },
    "env": {
        "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70",
        "MAX_THINKING_TOKENS": "10000"
    },
    "extraKnownMarketplaces": {
        "claude-plugins-official": {
            "source": {
                "repo": "anthropics/claude-plugins-official",
                "source": "github"
            }
        },
        "mmalyska-claude-plugins": {
            "source": {
                "repo": "mmalyska/claude-plugins",
                "source": "github"
            }
        }
    },
    "hooks": {
        "Notification": [
            {
                "hooks": [
                    {
                        "async": true,
                        "command": "~/.claude/hooks/peon-ping/peon.sh",
                        "timeout": 10,
                        "type": "command"
                    }
                ],
                "matcher": ""
            }
        ],
        "PermissionRequest": [
            {
                "hooks": [
                    {
                        "async": true,
                        "command": "~/.claude/hooks/peon-ping/peon.sh",
                        "timeout": 10,
                        "type": "command"
                    }
                ],
                "matcher": ""
            }
        ],
        "PostToolUseFailure": [
            {
                "hooks": [
                    {
                        "async": true,
                        "command": "~/.claude/hooks/peon-ping/peon.sh",
                        "timeout": 10,
                        "type": "command"
                    }
                ],
                "matcher": "Bash"
            }
        ],
        "PreCompact": [
            {
                "hooks": [
                    {
                        "async": true,
                        "command": "~/.claude/hooks/peon-ping/peon.sh",
                        "timeout": 10,
                        "type": "command"
                    }
                ],
                "matcher": ""
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "async": true,
                        "command": "~/.claude/hooks/peon-ping/peon.sh",
                        "timeout": 10,
                        "type": "command"
                    }
                ],
                "matcher": ""
            }
        ],
        "SessionStart": [
            {
                "hooks": [
                    {
                        "command": "~/.claude/hooks/peon-ping/peon.sh",
                        "timeout": 10,
                        "type": "command"
                    }
                ],
                "matcher": ""
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "async": true,
                        "command": "~/.claude/hooks/peon-ping/peon.sh",
                        "timeout": 10,
                        "type": "command"
                    }
                ],
                "matcher": ""
            }
        ],
        "SubagentStart": [
            {
                "hooks": [
                    {
                        "async": true,
                        "command": "~/.claude/hooks/peon-ping/peon.sh",
                        "timeout": 10,
                        "type": "command"
                    }
                ],
                "matcher": ""
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "async": true,
                        "command": "~/.claude/hooks/peon-ping/peon.sh",
                        "timeout": 10,
                        "type": "command"
                    }
                ],
                "matcher": ""
            },
            {
                "hooks": [
                    {
                        "command": "~/.claude/hooks/peon-ping/scripts/hook-handle-use.sh",
                        "timeout": 5,
                        "type": "command"
                    },
                    {
                        "command": "~/.claude/hooks/peon-ping/scripts/hook-handle-rename.sh",
                        "timeout": 5,
                        "type": "command"
                    }
                ],
                "matcher": ""
            }
        ]
    },
    "includeCoAuthoredBy": false,
    "model": "opusplan",
    "permissions": {
        "allow": []
    },
    "preferences": {
        "tmuxSplitPanes": true
    },
    "statusLine": {
        "command": "npx -y ccstatusline@latest --config ~/.claude/statusline/settings.json",
        "padding": 0,
        "type": "command"
    }
}
