{{- $ai := includeTemplate "ai-profile.tmpl" . | fromJson -}}
{{- $wf := .ai_workflow -}}
{{- $prof := get $wf.profiles $ai.profile -}}
{{- $own := get $wf.plugins $prof.own_set -}}
{{- $off := $wf.marketplace.official -}}
{
  "env": {
{{- if $ai.agent_teams }}
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
{{- end }}
    "MAX_THINKING_TOKENS": "10000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70"
  },
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      {{ if .is_work -}}
      "mcp__toolhive__*"
      {{- end }}
    ]
  },
  "model": "opusplan",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/peon-ping/scripts/hook-handle-use.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/peon-ping/scripts/hook-handle-rename.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/peon-ping/peon.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest --config ~/.claude/statusline/settings.json",
    "padding": 0
  },
  "enabledPlugins": {
{{- $entries := list }}
{{- if $prof.extras }}{{ range $wf.plugins.claude_extras }}{{ $entries = append $entries (printf "%s@%s" . $off.name) }}{{ end }}{{ end }}
{{- range $own }}{{ $entries = append $entries (printf "%s@%s" . $wf.marketplace.own.name) }}{{ end }}
{{- range $i, $e := $entries }}
    {{ $e | quote }}: true{{ if lt (add1 $i) (len $entries) }},{{ end }}
{{- end }}
  },
  "alwaysThinkingEnabled": true,
  "preferences": {
    "tmuxSplitPanes": true
  },
  "extraKnownMarketplaces": {
{{- if $prof.extras }}
    {{ $off.name | quote }}: {
      "source": {
        "source": "github",
        "repo": {{ $off.repo | quote }}
      }
    },
{{- end }}
    {{ $wf.marketplace.own.name | quote }}: {
      "source": {
        "source": "github",
        "repo": {{ $wf.marketplace.own.repo | quote }}
      }
    }
  }
}
