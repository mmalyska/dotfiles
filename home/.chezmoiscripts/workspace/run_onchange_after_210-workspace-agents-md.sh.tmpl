{{- if and (hasKey . "is_remote_workspace") .is_remote_workspace -}}
#!/usr/bin/env bash
# Write the workspace context file, /workspaces/AGENTS.md (docs/remote-workspace.md, "Workspace AGENTS.md").
# Renders to nothing, so chezmoi skips it, on every host that is not a remote workspace.
# Runs again when the text or the repository data changes, because it is part of this script: {{ includeTemplate "workspace-agents.md" . | sha256sum }}
# The file is generated: a local edit is replaced the next time the content changes. Rendering fails (the apply reports it)
# when a cloned repository has no entry in home/.chezmoidata/workspace-inventory.yaml.
set -u
root={{ .remote_workspace.root | quote }}
target="$root/AGENTS.md"
mkdir -p "$root" 2>/dev/null || true
tmp=$(mktemp "$root/.AGENTS.md.XXXXXX") || { echo "workspace-agents-md: cannot write in $root" >&2; exit 0; }
cat > "$tmp" <<'DOTFILES_WORKSPACE_AGENTS_EOF'
{{ includeTemplate "workspace-agents.md" . -}}
DOTFILES_WORKSPACE_AGENTS_EOF
if [ -f "$target" ] && cmp -s "$tmp" "$target"; then
    rm -f "$tmp"
    echo "workspace-agents-md: $target is up to date"
else
    # A file that was not generated here is somebody's hand-written copy: keep the first one next to it, never overwrite it.
    if [ -f "$target" ] && ! grep -q 'Generated by chezmoi from mmalyska/dotfiles' "$target" && [ ! -e "$root/AGENTS.md.pre-chezmoi" ]; then
        cp -p "$target" "$root/AGENTS.md.pre-chezmoi"
        echo "workspace-agents-md: kept the previous file as $root/AGENTS.md.pre-chezmoi"
    fi
    chmod 644 "$tmp"
    mv -f "$tmp" "$target"
    echo "workspace-agents-md: wrote $target"
fi
exit 0
{{- end }}
