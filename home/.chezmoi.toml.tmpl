{{- $email := promptStringOnce . "email" "Email address for git" "999598+mmalyska@users.noreply.github.com" -}}
{{- $user := promptStringOnce . "user" "User name for git" "Michał Małyska" -}}
{{- $isWork := promptBoolOnce . "isWork" "If work machine" false -}}

{{- $isWSL := false -}}
{{- $isArch := false -}}
{{- $isDevContainer := or (eq .chezmoi.username "vscode") (ne (env "REMOTE_CONTAINERS") "") (ne (env "CODESPACES") "") (ne (env "DEVCONTAINER") "") -}}

{{- if and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}
    {{- $isWSL = true -}}
{{- end -}}

{{- if eq .chezmoi.os "linux" -}}
    {{- $osId     := get .chezmoi.osRelease "id"      | default "" -}}
    {{- $osIdLike := get .chezmoi.osRelease "id_like" | default "" -}}
    {{- if or (eq $osId "arch") (eq $osId "cachyos") (contains "arch" $osIdLike) -}}
        {{- $isArch = true -}}
    {{- end -}}
{{- end -}}

{{- /*
  AI workflow profile (see docs/plans/hybrid-ai-workflow-dotfiles/plan.md, D-G).
  An existing host is recognised by an already existing chezmoi config file that has no ai_profile yet
  (NOT by the missing key alone: a new host lacks it too). Such a host keeps its previous setup,
  written explicitly and without asking: claude-extended + agent teams (unless init --prompt asks to migrate). A new host gets the core profile.
  --promptChoice/--promptBool flags are keyed by the prompt text, so keep the texts in sync with tests/ai/lib.sh.
*/ -}}
{{- $aiExisting := stat .chezmoi.configFile -}}
{{- $aiReprompt := has "--prompt" .chezmoi.args -}}
{{- $aiLegacyHost := and $aiExisting (not (hasKey . "ai_profile")) (not $aiReprompt) -}}
{{- $aiProfile := "claude-extended" -}}
{{- $aiTeams := true -}}
{{- $aiClaude := true -}}
{{- $aiCodex := true -}}
{{- $aiOpencode := false -}}
{{- if not $aiLegacyHost -}}
{{-   $aiProfile = promptChoiceOnce . "ai_profile" "AI profile" (list "minimal" "core" "claude-extended") "core" -}}
{{-   $aiTeams = promptBoolOnce . "ai_agent_teams" "Enable Claude agent teams" false -}}
{{-   $aiClaude = promptBoolOnce . "ai_claude" "Configure Claude Code plugins" true -}}
{{-   $aiCodex = promptBoolOnce . "ai_codex" "Configure Codex plugins" true -}}
{{-   $aiOpencode = promptBoolOnce . "ai_opencode" "Enable OpenCode (experimental, not implemented)" false -}}
{{- end }}

[data]
    email         = {{ $email | quote }}
    user          = {{ $user  | quote }}
    is_wsl        = {{ $isWSL }}
    is_arch       = {{ $isArch }}
    is_work       = {{ $isWork }}
    is_devcontainer = {{ $isDevContainer }}
    ai_profile      = {{ $aiProfile | quote }}
    ai_agent_teams  = {{ $aiTeams }}
    ai_claude       = {{ $aiClaude }}
    ai_codex        = {{ $aiCodex }}
    ai_opencode     = {{ $aiOpencode }}

[merge]
    command = "bash"
    args = [
        "-c",
        "cp {{ "{{" }} .Target | quote {{ "}}" }} {{ "{{" }} .Target | quote {{ "}}" }}.base && code --new-window --wait --merge {{ "{{" }} .Destination | quote {{ "}}" }} {{ "{{" }} .Target | quote {{ "}}" }} {{ "{{" }} .Target | quote {{ "}}" }}.base {{ "{{" }} .Source | quote {{ "}}" }}",
    ]
