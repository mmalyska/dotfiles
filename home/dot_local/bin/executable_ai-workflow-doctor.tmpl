{{- $ai := includeTemplate "ai-profile.tmpl" . | fromJson -}}
{{- $wf := .ai_workflow -}}
{{- $own := $wf.marketplace.own -}}
{{- $official := $wf.marketplace.official -}}
{{- $profile := index $wf.profiles $ai.profile -}}
{{- $plugins := index $wf.plugins $profile.own_set -}}
{{- $extras := list -}}
{{- if $profile.extras }}{{ $extras = $wf.plugins.claude_extras }}{{ end -}}
{{- $claude := true -}}
{{- if hasKey . "ai_claude" }}{{ $claude = .ai_claude }}{{ end -}}
{{- $codex := true -}}
{{- if hasKey . "ai_codex" }}{{ $codex = .ai_codex }}{{ end -}}
{{- $opencode := false -}}
{{- if hasKey . "ai_opencode" }}{{ $opencode = .ai_opencode }}{{ end -}}
#!/usr/bin/env bash
# ai-workflow-doctor: read-only report on the AI workflow installers (managed by chezmoi, do not edit in place).
# Usage: ai-workflow-doctor [--strict | --quiet | --hook]
#   --strict  exit 1 on DRIFT, MISSING, a pending upgrade or an installer result of "partial" (skipped is never an error)
#   --quiet   print nothing when all is well; otherwise one line per thing to do. Always exit 0. Meant for a shell prompt
#   --hook    like --quiet, as the JSON a Claude Code SessionStart hook shows to the user and the model. Always exit 0
# Reads the installer status files and asks the CLIs for their lists. It never writes, installs, adds or updates anything;
# when an installer ended "partial" it only PRINTS the command that re-runs that single installer.
# Needs ~/.local/bin on PATH.
set -u

PROFILE={{ $ai.profile | quote }}
AGENT_TEAMS={{ if hasKey . "ai_agent_teams" }}{{ .ai_agent_teams }}{{ else }}{{ $ai.profile | eq "claude-extended" }}{{ end }}
USE_CLAUDE={{ $claude }}
USE_CODEX={{ $codex }}
USE_OPENCODE={{ $opencode }}
ACCEPTED_SHA={{ $own.accepted_sha | quote }}
SOURCE_DIR={{ .chezmoi.sourceDir | quote }}
OWN_NAME={{ $own.name | quote }}
OWN_REPO={{ $own.repo | quote }}
OFFICIAL_NAME={{ $official.name | quote }}
PLUGINS={{ join " " $plugins | quote }}
EXTRAS={{ join " " $extras | quote }}
DEST_DIR={{ .chezmoi.destDir | quote }}

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/ai-workflow"
STRICT=0
MODE=report
for arg in "$@"; do
    case "$arg" in
        --strict) STRICT=1;;
        --quiet) MODE=quiet;;
        --hook) MODE=hook;;
    esac
done
BAD=0

have() { command -v "$1" >/dev/null 2>&1; }
flag() { [ "$1" = true ] && echo enabled || echo disabled; }
version() { local v; v=$("$1" --version 2>/dev/null | head -n 1) || v=""; echo "${v:-unknown}"; }
status_field() { sed -n "s/^$2=//p" "$STATE_DIR/$1.status" 2>/dev/null | head -n 1; }
ids() { sed -n "s/.*\"$1\": *\"\\([^\"]*\\)\".*/\\1/p"; }
has_word() { case " $1 " in *" $2 "*) return 0;; esac; return 1; }

# plugin_report <harness> <installed ids, one per line>
plugin_report() {
    local h=$1 installed=$2 p missing="" extra="" n=0 total=0
    for p in $PLUGINS; do
        total=$((total + 1))
        if printf '%s\n' "$installed" | grep -qxF "$p@$OWN_NAME"; then n=$((n + 1)); else missing="$missing $p"; fi
    done
    if [ "$h" = claude ]; then
        for p in $EXTRAS; do
            total=$((total + 1))
            if printf '%s\n' "$installed" | grep -qxF "$p@$OFFICIAL_NAME"; then n=$((n + 1)); else missing="$missing $p@$OFFICIAL_NAME"; fi
        done
    fi
    while IFS= read -r p; do
        [ -n "$p" ] || continue
        case "$p" in
            *@"$OWN_NAME") has_word "$PLUGINS" "${p%@*}" || extra="$extra $p";;
            *@"$OFFICIAL_NAME") has_word "$EXTRAS" "${p%@*}" || extra="$extra $p";;
        esac
    done <<< "$installed"
    if [ -n "$missing" ]; then
        PLUGIN_STATE="MISSING"; BAD=1
    else
        PLUGIN_STATE="OK"
    fi
    PLUGIN_COUNT="$n/$total"
    [ -z "$missing" ] || echo "  MISSING:$missing"
    [ -z "$extra" ] || echo "  EXTRA (not in profile $PROFILE, left alone):$extra"
    if printf '%s\n' "$installed" | grep -q '^superpowers@' && ! has_word "$EXTRAS" superpowers; then
        echo "  WARN superpowers is enabled in $h but profile $PROFILE does not include it"
    fi
}

# recovery_hint <harness> <script basename>: prints, never runs
recovery_hint() {
    cat <<HINT
  To re-run only the $1 installer, run these two commands yourself:
    chezmoi state delete --bucket=entryState --key="$DEST_DIR/.chezmoiscripts/ai/$2"
    chezmoi apply
  Only that script runs again; do not use delete-bucket or "state reset".
HINT
}

# report <harness> <enabled> <script basename>
report() {
    local h=$1 enabled=$2 script=$3 mp result fails installed
    echo "[$h] $(flag "$enabled")"
    result=$(status_field "$h" result)
    fails=$(status_field "$h" fails)
    if [ "$enabled" != true ]; then echo "  skipped: ai_$h=false"; return; fi
    if ! have "$h"; then echo "  CLI: ABSENT (installer skips until it is installed)"; echo "  installer: ${result:-no status}"; return; fi
    echo "  CLI: $(version "$h")"
    if [ "$h" = claude ]; then mp=$(marketplace_claude); else mp=$(marketplace_codex); fi
    echo "  marketplace $OWN_NAME: $mp"
    [ "$mp" != DRIFT ] || BAD=1
    if [ "$h" = codex ] && [ "$mp" = DRIFT ]; then
        echo "  The Codex pin cannot be edited in place; run these yourself:"
        codex_repin_commands | sed 's/^/    /'
    fi
    if [ "$h" = claude ]; then
        installed=$(claude plugin list --json 2>/dev/null | ids id)
    else
        installed=$(codex plugin list --json 2>/dev/null | ids pluginId)
    fi
    plugin_report "$h" "$installed"
    echo "  plugins: $PLUGIN_COUNT $PLUGIN_STATE"
    echo "  installer: ${result:-no status}${fails:+ (fails=$fails)}"
    if [ "$result" = partial ]; then
        BAD=1
        recovery_hint "$h" "$script"
    elif [ "$PLUGIN_STATE" = MISSING ] && [ "$result" != skipped ]; then
        recovery_hint "$h" "$script"
    fi
}

# codex_repin_commands: the commands that move the Codex marketplace pin (it cannot be edited in place); printed, never run
codex_repin_commands() {
    cat <<REPIN
codex plugin marketplace remove $OWN_NAME
codex plugin marketplace add $OWN_REPO --ref $ACCEPTED_SHA
codex plugin add <name>@$OWN_NAME   (once for each plugin of the profile: $PLUGINS)
REPIN
}

marketplace_claude() {
    local dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/marketplaces/$OWN_NAME" head
    head=$(git -C "$dir" rev-parse HEAD 2>/dev/null) || head=""
    if [ -z "$head" ]; then echo ABSENT; elif [ "$head" = "$ACCEPTED_SHA" ]; then echo OK; else echo DRIFT; fi
}
marketplace_codex() {
    local cfg="${CODEX_HOME:-$HOME/.codex}/config.toml" ref=""
    [ -r "$cfg" ] && ref=$(awk -v sec="[marketplaces.$OWN_NAME]" '
        /^\[/ { in_sec = ($0 == sec); next }
        in_sec && $1 == "ref" { gsub(/^[^"]*"|"[^"]*$/, ""); print; exit }
    ' "$cfg")
    if [ -z "$ref" ]; then echo ABSENT; elif [ "$ref" = "$ACCEPTED_SHA" ]; then echo OK; else echo DRIFT; fi
}

# ---- pending upgrades: what a merged pin or a newer plugin version still needs from the owner ----
# pin_of <accepted_sha|accepted_tag>: reads the data file on stdin
pin_of() { sed -n "s/^ *$1: *//p" | head -n 1; }

# refresh_upstream: git fetch of the chezmoi source, at most once per FETCH_EVERY (30) minutes, never longer than 4 s, silent on failure
FETCH_EVERY=30
refresh_upstream() {
    local stamp="$STATE_DIR/source-fetch" pid ticks=0
    git -C "$SOURCE_DIR" rev-parse --verify -q '@{upstream}' >/dev/null 2>&1 || return 0
    if [ -e "$stamp" ] && [ -z "$(find "$stamp" -mmin +"$FETCH_EVERY" 2>/dev/null)" ]; then return 0; fi
    mkdir -p "$STATE_DIR" 2>/dev/null && : > "$stamp"
    # no timeout(1) on a stock macOS: a watchdog stops the fetch after about 4 seconds
    GIT_TERMINAL_PROMPT=0 git -C "$SOURCE_DIR" fetch --quiet >/dev/null 2>&1 &
    pid=$!
    while kill -0 "$pid" 2>/dev/null && [ "$ticks" -lt 40 ]; do sleep 0.1; ticks=$((ticks + 1)); done
    if kill -0 "$pid" 2>/dev/null; then kill "$pid" 2>/dev/null; fi
    wait "$pid" 2>/dev/null || true
}

# plugin_versions <json>: "<id> <version>" lines from `claude plugin list --json`
plugin_versions() {
    awk -F'"' '/"id":/ { id = $4 } /"version":/ && id != "" { print id, $4; id = "" }'
}

# pending_upgrades [upstream]: sets PENDING (one line per thing to do). With "upstream" it also compares the source to its remote.
pending_upgrades() {
    PENDING=""
    local data="$SOURCE_DIR/.chezmoidata/ai-workflow.yaml" want up_sha up_tag behind
    if [ "${1:-}" = upstream ] && git -C "$SOURCE_DIR" rev-parse --verify -q '@{upstream}' >/dev/null 2>&1; then
        behind=$(git -C "$SOURCE_DIR" rev-list --count 'HEAD..@{upstream}' 2>/dev/null || echo 0)
        if [ "${behind:-0}" -gt 0 ]; then
            up_sha=$(git -C "$SOURCE_DIR" show '@{upstream}:./.chezmoidata/ai-workflow.yaml' 2>/dev/null | pin_of accepted_sha)
            up_tag=$(git -C "$SOURCE_DIR" show '@{upstream}:./.chezmoidata/ai-workflow.yaml' 2>/dev/null | pin_of accepted_tag)
            if [ -n "$up_sha" ] && [ "$up_sha" != "$ACCEPTED_SHA" ]; then
                PENDING="${PENDING}A newer claude-plugins revision is accepted upstream (${up_tag:-$up_sha}): chezmoi git pull, read chezmoi diff, then AI_WORKFLOW_UPGRADE=1 chezmoi apply, then ai-workflow-doctor --strict
"
            fi
        fi
    fi
    if [ -r "$data" ]; then
        want=$(pin_of accepted_sha < "$data")
        if [ -n "$want" ] && [ "$want" != "$ACCEPTED_SHA" ] && [ -z "$PENDING" ]; then
            PENDING="${PENDING}The dotfiles source accepts claude-plugins ${want} but this host runs ${ACCEPTED_SHA}: AI_WORKFLOW_UPGRADE=1 chezmoi apply, then ai-workflow-doctor --strict
"
        fi
    fi
    if [ "$USE_CLAUDE" = true ] && have claude; then
        local mp="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/marketplaces/$OWN_NAME" id ver have_ver stale=""
        while read -r id ver; do
            case "$id" in *@"$OWN_NAME") ;; *) continue;; esac
            [ -r "$mp/plugins/${id%@*}/.claude-plugin/plugin.json" ] || continue
            have_ver=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$mp/plugins/${id%@*}/.claude-plugin/plugin.json" | head -n 1)
            if [ -n "$have_ver" ] && [ "$have_ver" != "$ver" ]; then stale="$stale ${id%@*} $ver->$have_ver,"; fi
        done < <(claude plugin list --json 2>/dev/null | plugin_versions)
        if [ -n "$stale" ]; then
            PENDING="${PENDING}Installed plugins are behind the marketplace checkout:${stale%,}. Run claude plugin update <name>@$OWN_NAME for each, then start a new session
"
        fi
    fi
}

json_escape() { sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | awk 'BEGIN { ORS = "" } { if (NR > 1) print "\\n"; print }'; }

# quiet_mode: --quiet and --hook. Prints nothing when all is well; always exits 0
quiet_mode() {
    local lines="" h mp
    refresh_upstream
    pending_upgrades upstream
    lines=$PENDING
    for h in claude codex; do
        if [ "$h" = claude ]; then [ "$USE_CLAUDE" = true ] || continue; else [ "$USE_CODEX" = true ] || continue; fi
        have "$h" || continue
        if [ "$h" = claude ]; then mp=$(marketplace_claude); else mp=$(marketplace_codex); fi
        if [ "$mp" = DRIFT ]; then
            if [ "$h" = codex ]; then
                lines="${lines}The codex marketplace $OWN_NAME is not at the accepted revision. Its pin cannot be edited in place: codex plugin marketplace remove $OWN_NAME; codex plugin marketplace add $OWN_REPO --ref $ACCEPTED_SHA; then codex plugin add <name>@$OWN_NAME for each plugin (ai-workflow-doctor lists them)
"
            else
                lines="${lines}The $h marketplace $OWN_NAME is not at the accepted revision: AI_WORKFLOW_UPGRADE=1 chezmoi apply
"
            fi
        fi
        [ "$(status_field "$h" result)" != partial ] || lines="${lines}The $h installer ended partial: ai-workflow-doctor shows the commands that re-run it
"
    done
    [ -n "$lines" ] || exit 0
    lines=$(printf '%s' "$lines" | sed '/^$/d')
    if [ "$MODE" = hook ]; then
        local msg
        msg=$(printf 'AI workflow: action needed\n%s' "$(printf '%s\n' "$lines" | sed 's/^/- /')" | json_escape)
        printf '{"systemMessage":"%s","hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$msg" "$msg"
    else
        printf '%s\n' "$lines"
    fi
    exit 0
}

[ "$MODE" = report ] || quiet_mode

echo "AI workflow doctor"
echo "profile: $PROFILE   agent_teams: $AGENT_TEAMS"
echo "accepted_sha: $ACCEPTED_SHA"
echo
report claude "$USE_CLAUDE" 100-claude-plugins.sh
echo
report codex "$USE_CODEX" 110-codex-plugins.sh
echo
echo "[opencode] $(flag "$USE_OPENCODE")"
if have opencode; then echo "  CLI: $(version opencode)"; else echo "  CLI: ABSENT"; fi
if [ "$USE_OPENCODE" = true ]; then echo "  spike not implemented: nothing is installed or configured for OpenCode (docs/workflow/opencode-spike.md)"; fi
echo
pending_upgrades
if [ -n "$PENDING" ]; then
    echo "[pending]"
    printf '%s' "$PENDING" | sed 's/^/  /'
    echo
    BAD=1
fi
if [ "$BAD" = 1 ]; then echo "result: PROBLEMS FOUND"; else echo "result: OK"; fi
if [ "$STRICT" = 1 ] && [ "$BAD" = 1 ]; then exit 1; fi
exit 0
